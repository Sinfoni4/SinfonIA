{
  "name": "sinfonia",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "predev": "tsx scripts/env.check.ts",
    "dev": "tsx watch src/index.ts",
    "dev:debug": "tsx watch --inspect src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "dotenv -e .env.test -- tsx scripts/test-db.ts --mode=strict && dotenv -e .env.test -- tsx tests/core/ai.core.harness.ts --mode=strict",
    "test:domain": "dotenv -e .env.test -- tsx scripts/test-db.ts --mode=strict && dotenv -e .env.test -- tsx tests/domain/artist-practice.harness.ts --mode=strict",
    "test:all": "dotenv -e .env.test -- tsx scripts/test-db.ts --mode=strict && dotenv -e .env.test -- tsx tests/test.all.ts --mode=strict",
    "ai:test": "dotenv -e .env.test -- tsx scripts/test-db.ts && dotenv -e .env.test -- tsx tests/ai.behavior.harness.ts",
    "ai:test:real": "dotenv -e .env.test -- tsx scripts/test-db.ts --mode=strict && dotenv -e .env.test -- tsx tests/ai.behavior.harness.ts --mode=strict",
    "ai:eval": "tsx scripts/run-eval.ts",
    "ai:eval:nightly": "tsx scripts/run-eval.ts --nightly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:diag": "tsx src/devtools/runDbDiagnostics.ts",
    "db:explain": "tsx scripts/explain-queries.ts",
    "db:setup": "tsx scripts/db.setup.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,yml,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,yml,md}\"",
    "secret:scan": "node scripts/secret-scan.mjs",
    "audit:prod": "npm audit --omit=dev",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:db:reset": "docker compose -f docker-compose.test.yml down -v && npm run test:db:up && npm run test:db:migrate",
    "test:integration": "npm run test:db:up && npm run test:db:migrate && npm test",
    "env:check": "tsx scripts/env.check.ts",
    "auth:token": "tsx scripts/auth.token.ts",
    "tenant:provision": "tsx scripts/tenant.provision.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/multipart": "10.1.3",
    "@napi-rs/canvas": "1.0.11",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tesseract.js-data/ita": "1.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@eslint/js": "^9.39.4",
    "@rolldown/binding-win32-x64-msvc": "^1.2.15",
    "@types/node": "^25.5.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.14",
    "pdf-lib": "1.17.1",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  }
}
