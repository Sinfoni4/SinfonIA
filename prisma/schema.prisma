generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enterprise data model:
// - strict multi-tenancy (tenant_id on every entity)
// - auditability (append-only audit_log)
// - stable naming: snake_case columns mapped from camelCase fields
// This schema is designed to avoid destructive refactors later.

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  module             String   @default("music")
  integrationType    String   @default("none") @map("integration_type")
  schedulerEnabled   Boolean  @default(false) @map("scheduler_enabled")
  schedulerFrequency String?  @map("scheduler_frequency")
  schedulerTasks     Json?    @map("scheduler_tasks")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  users       User[]
  practices   Practice[]
  auditLogs   AuditLog[]
  invites     InviteCode[]
  userTenants UserTenant[]

  @@map("tenant")
}

model InviteCode {
  code      String   @id
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invite_code")
}

model UserTenant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant")
}

enum UserRole {
  ADMIN
  OPERATOR
  MEMBER
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  email      String
  role       UserRole @default(MEMBER)
  telegramId String?  @map("telegram_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practices Practice[]
  auditLogs AuditLog[]

  @@unique([tenantId, telegramId])
  @@index([tenantId])
  @@index([tenantId, id])
  @@map("user")
}

enum PracticeStatus {
  CREATED
  VALIDATED
  SUBMITTED
  FAILED
  COMPLETED
}

model Practice {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  status    PracticeStatus @default(CREATED)
  version   Int            @default(1)
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, id, version])
  @@map("practice")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, eventType])
  @@map("audit_log")
}
