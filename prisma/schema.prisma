generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enterprise data model:
// - strict multi-tenancy (tenant_id on every entity)
// - auditability (append-only audit_log)
// - stable naming: snake_case columns mapped from camelCase fields
// This schema is designed to avoid destructive refactors later.

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  module             String   @default("music")
  integrationType    String   @default("none") @map("integration_type")
  schedulerEnabled   Boolean  @default(false) @map("scheduler_enabled")
  schedulerFrequency String?  @map("scheduler_frequency")
  schedulerTasks     Json?    @map("scheduler_tasks")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @map("updated_at")

  users          User[]
  practices      Practice[]
  auditLogs      AuditLog[]
  invites        InviteCode[]
  userTenants    UserTenant[]
  schedulerJobs  SchedulerJob[]
  schedulerRuns  SchedulerRun[]
  outboxMessages OutboxMessage[]
  attachments    PracticeAttachment[]

  @@map("tenant")
}

model InviteCode {
  code      String   @id
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invite_code")
}

model UserTenant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant")
}

enum UserRole {
  ADMIN
  OPERATOR
  MEMBER
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  email      String
  role       UserRole @default(MEMBER)
  telegramId String?  @map("telegram_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practices Practice[]
  auditLogs AuditLog[]

  @@unique([tenantId, telegramId])
  @@index([tenantId])
  @@index([tenantId, id])
  @@map("user")
}

enum PracticeStatus {
  CREATED
  VALIDATED
  SUBMITTED
  FAILED
  COMPLETED
}

model Practice {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  status    PracticeStatus @default(CREATED)
  version   Int            @default(1)
  payload   Json
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  attachments PracticeAttachment[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, id, version])
  @@index([payload], type: Gin)
  @@map("practice")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@index([tenantId, eventType])
  @@map("audit_log")
}

enum SchedulerRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model SchedulerJob {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  taskType  String    @map("task_type")
  frequency String    @default("monthly")
  enabled   Boolean   @default(true)
  payload   Json?
  lastRunAt DateTime? @map("last_run_at")
  nextRunAt DateTime? @map("next_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   SchedulerRun[]

  @@index([tenantId])
  @@index([enabled, nextRunAt])
  @@map("scheduler_job")
}

model SchedulerRun {
  id             String             @id @default(uuid()) @db.Uuid
  jobId          String?            @map("job_id") @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  idempotencyKey String             @unique @map("idempotency_key")
  status         SchedulerRunStatus @default(RUNNING)
  startedAt      DateTime           @default(now()) @map("started_at")
  completedAt    DateTime?          @map("completed_at")
  error          String?
  result         Json?
  createdAt      DateTime           @default(now()) @map("created_at")

  job    SchedulerJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([jobId])
  @@index([status])
  @@map("scheduler_run")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxMessage {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  error       String?
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, createdAt])
  @@map("outbox_message")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PracticeAttachment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  practiceId  String    @map("practice_id") @db.Uuid
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  fileSize    Int       @map("file_size")
  storagePath String    @map("storage_path")
  ocrStatus   OcrStatus @default(PENDING) @map("ocr_status")
  ocrResult   Json?     @map("ocr_result")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([practiceId])
  @@index([tenantId, ocrStatus])
  @@map("practice_attachment")
}
