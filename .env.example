NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sinfonia?schema=public
SERVICE_NAME=sinfonia

# Telegram bot (optional). Generate a token with @BotFather.
# Never commit the real value.
TELEGRAM_BOT_TOKEN=

# LLM (optional): set ENABLE_LLM=true to use OpenAI for POST /ai/execute.
# Without these values the deterministic stub interpreter is used.
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth (HS256 signed bearer tokens). Use at least 32 random characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=sinfonia
AUTH_AUDIENCE=sinfonia-api
AUTH_TTL_SECONDS=3600

# Attachments: maximum size in bytes of a single uploaded document (default 10 MB).
# OCR runs in-process (Tesseract, Italian model bundled): no document leaves the server.
ATTACHMENT_MAX_BYTES=10485760

# Attachment storage: "local" (default, .runtime/storage) or "s3" (AWS S3 or MinIO).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/var/lib/sinfonia/storage
# S3_BUCKET=sinfonia-attachments
# S3_REGION=eu-south-1
# MinIO: set the endpoint and path-style addressing.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SERVER_SIDE_ENCRYPTION=AES256

# Background workers: scheduler tick and outbox delivery.
SCHEDULER_INTERVAL_MS=60000
OUTBOX_DISPATCH_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
# Secret (32+ chars) for signing webhook deliveries. Without it tenant webhooks are not sent.
# OUTBOX_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta). The channel is on only when the four values are all set.
# Webhook URL to configure in the Meta app: https://<host>/webhooks/whatsapp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=at-least-16-random-characters
# WHATSAPP_API_VERSION=v21.0

# LLM provider: openai (default) or azure (Azure OpenAI resource in an EU region).
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# HTTP request limits per minute: per user, per user on /ai/execute, per tenant.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_TENANT_PER_MINUTE=600
