NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sinfonia?schema=public
SERVICE_NAME=sinfonia

# Telegram bot (optional). Generate a token with @BotFather.
# Never commit the real value.
TELEGRAM_BOT_TOKEN=

# LLM (optional): set ENABLE_LLM=true to use OpenAI for POST /ai/execute.
# Without these values the deterministic stub interpreter is used.
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
